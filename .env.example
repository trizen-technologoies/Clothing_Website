# Copy to .env.local and fill in. Never commit real values.
# All variables are server-only — none are exposed to the browser.

# --- Shopify Storefront API (optional) -----------------------------------
# Leave empty to run the built-in demo catalogue and simulated checkout.
# Store domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Private Storefront API access token (Headless channel → Storefront API).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2026-07. Keep within Shopify's supported window.
SHOPIFY_STOREFRONT_API_VERSION=
